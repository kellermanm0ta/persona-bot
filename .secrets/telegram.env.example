# Copie para .secrets/<persona>/telegram.env e preencha:
#   mkdir -p .secrets/<persona>
#   cp .secrets/telegram.env.example .secrets/<persona>/telegram.env
#   chmod 600 .secrets/<persona>/telegram.env
#
# Um bot/token por persona (crie cada um no @BotFather).

# Token do bot gerado no @BotFather.
TELEGRAM_BOT_TOKEN=

# IDs do Telegram autorizados a usar o bot (separados por virgula).
# Vazio = todos. Envie /id no chat do bot para descobrir o seu.
TELEGRAM_ALLOWED_USER_IDS=
