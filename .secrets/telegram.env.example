# Copie para .secrets/telegram.env e preencha:
#   cp .secrets/telegram.env.example .secrets/telegram.env
#   chmod 600 .secrets/telegram.env

# Token do bot gerado no @BotFather.
TELEGRAM_BOT_TOKEN=

# IDs do Telegram autorizados a usar o bot (separados por virgula).
# Vazio = todos. Envie /id no chat do bot para descobrir o seu.
TELEGRAM_ALLOWED_USER_IDS=
