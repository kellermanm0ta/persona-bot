# Copie para .secrets/openrouter.env e preencha:
#   cp .secrets/openrouter.env.example .secrets/openrouter.env
#   chmod 600 .secrets/openrouter.env

# Chave da OpenRouter (usada pelo runtime.py para gerar as respostas).
OPENROUTER_API_KEY=

# Opcional: sobrescreve o modelo do frontmatter do agente.
# OPENROUTER_MODEL_BUKOWSKI=deepseek/deepseek-v4.1-flash

# Opcional: modelo de embedding local (fastembed/ONNX) usado pela busca hibrida.
# BUKOWSKI_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
